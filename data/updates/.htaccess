# ModoCMS .htaccess v3.1 - do not remove this line
#
# This directory holds downloaded update packages and the release cache. It must
# never be reachable over HTTP. PHP itself is unaffected: Apache authorization
# rules only apply to direct web requests.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes -ExecCGI
